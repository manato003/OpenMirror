<chrome:RoundedWindow x:Class="IPhoneMirror.App.Windows.HomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="clr-namespace:IPhoneMirror.UI.Controls"
        xmlns:animations="clr-namespace:IPhoneMirror.UI.Animations"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="iPhoneMirror" Width="408" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="True" WindowStartupLocation="CenterScreen"
        Foreground="{DynamicResource TextBrush}" PreviewKeyDown="OnPreviewKeyDown">
    <chrome:RoundedWindow.Resources>
        <!-- Small text that explains, never instructs twice. -->
        <Style x:Key="HomeCaption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            <Setter Property="FontSize" Value="{DynamicResource SecondaryFontSize}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="18"/>
        </Style>
        <Style x:Key="HomeSectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            <Setter Property="FontSize" Value="{DynamicResource SecondaryFontSize}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="4,0,0,8"/>
        </Style>

        <!-- Plain icon/text button without a frame: the footer and row actions. -->
        <Style x:Key="HomeQuietButton" TargetType="Button" BasedOn="{StaticResource CompactButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>

        <!-- Quality: the iOS segmented control, because the choice is made
             exactly the way the phone's own settings present one of a few. -->
        <Style x:Key="HomeSegment" TargetType="RadioButton">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
            <Setter Property="FontSize" Value="{DynamicResource SecondaryFontSize}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Segment" CornerRadius="8" Padding="0,7" Margin="2"
                                Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Segment" Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Segment" Property="Background" Value="{DynamicResource PanelRaisedBrush}"/>
                                <Setter TargetName="Segment" Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- On/off: the iOS switch, green when on, as in the phone's settings. -->
        <Style x:Key="HomeSwitch" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Width="44" Height="26" Background="Transparent">
                            <Border x:Name="Track" CornerRadius="13" Background="{DynamicResource SliderTrackBrush}"/>
                            <Ellipse x:Name="Thumb" Width="22" Height="22" Margin="2,0,0,0"
                                     HorizontalAlignment="Left" Fill="{DynamicResource SliderThumbFillBrush}">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="ThumbOffset" X="0"/>
                                </Ellipse.RenderTransform>
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.25"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbOffset" Storyboard.TargetProperty="X"
                                                             To="18" Duration="0:0:0.14">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbOffset" Storyboard.TargetProperty="X"
                                                             To="0" Duration="0:0:0.14">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </chrome:RoundedWindow.Resources>

    <!-- Opaque: home sits over whatever the user was doing, and the hero must read clearly. -->
    <Border Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Style="{StaticResource SubWindowPageRoot}" animations:PageTransition.IsEnabled="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Who is listening, and whether it can be found right now. -->
        <Grid animations:WindowDragBehavior.IsEnabled="True" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Margin="4,2,0,0">
                <TextBlock Text="iPhoneMirror" Style="{StaticResource SubWindowTitle}" FontSize="{DynamicResource FontSize15}"/>
                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                    <Ellipse x:Name="StatusDot" Width="7" Height="7" VerticalAlignment="Center" Margin="0,1,7,0"
                             Fill="{DynamicResource MutedTextBrush}"/>
                    <TextBlock x:Name="StatusText" Style="{StaticResource HomeCaption}" TextWrapping="NoWrap"
                               AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource TitleBarButton}" Width="36" Height="36" MinHeight="36"
                        Click="OnMinimizeClick" ToolTip="{DynamicResource Minimize}"
                        AutomationProperties.Name="{DynamicResource Minimize}">
                    <ui:SymbolIcon Style="{StaticResource ButtonSymbolIcon}" Symbol="Subtract20" FontSize="15"/>
                </Button>
                <Button Style="{StaticResource SubWindowCloseButton}" Width="36" Height="36" MinHeight="36"
                        Click="OnHideClick" ToolTip="{DynamicResource HomeHideToolTip}"
                        AutomationProperties.Name="{DynamicResource HomeHideToolTip}">
                    <ui:SymbolIcon Style="{StaticResource ButtonSymbolIcon}" Symbol="Dismiss20" FontSize="16"/>
                </Button>
            </StackPanel>
        </Grid>
        <TextBlock x:Name="StatusDetail" Grid.Row="1" Style="{StaticResource HomeCaption}" Visibility="Collapsed"
                   Foreground="{DynamicResource ErrorBrush}" Margin="4,8,4,0"/>

        <!-- The hero: the list on the phone, with this PC's real name in it. -->
        <StackPanel Grid.Row="2" Margin="0,18,0,0">
            <Border CornerRadius="20" Padding="14,12,14,14" Background="{DynamicResource ControlFillBrush}"
                    BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{DynamicResource HomeSheetTitle}" HorizontalAlignment="Center"
                               FontSize="{DynamicResource FontSize13}" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <Border CornerRadius="12" Background="{DynamicResource PanelRaisedBrush}" Padding="12,0,6,0" MinHeight="52">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="Tv20" FontSize="22" VerticalAlignment="Center" Margin="0,0,12,0"
                                           Foreground="{DynamicResource TextBrush}"/>
                            <!-- Read mode: the name exactly as the phone lists it. -->
                            <Button x:Name="ReceiverNameButton" Grid.Column="1" Click="OnEditNameClick"
                                    Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                                    HorizontalContentAlignment="Left" VerticalAlignment="Center"
                                    ToolTip="{DynamicResource HomeRenameToolTip}"
                                    AutomationProperties.Name="{DynamicResource HomeRenameToolTip}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock x:Name="ReceiverNameText" FontSize="{DynamicResource FontSize15}" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                            </Button>
                            <!-- Edit mode: same place, same size. -->
                            <TextBox x:Name="ReceiverNameBox" Grid.Column="1" Visibility="Collapsed" MaxLength="63"
                                     Style="{StaticResource RoundedTextBox}" VerticalAlignment="Center" MinHeight="36"
                                     KeyDown="OnNameBoxKeyDown" LostKeyboardFocus="OnNameBoxLostFocus"
                                     AutomationProperties.Name="{DynamicResource HomeRenameToolTip}"/>
                            <Button x:Name="EditNameButton" Grid.Column="2" Style="{StaticResource HomeQuietButton}"
                                    Click="OnEditNameClick" Margin="6,0,0,0" Padding="8"
                                    ToolTip="{DynamicResource HomeRenameToolTip}"
                                    AutomationProperties.Name="{DynamicResource HomeRenameToolTip}">
                                <ui:SymbolIcon x:Name="EditNameIcon" Style="{StaticResource ButtonSymbolIcon}" Symbol="Edit20" FontSize="16"/>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
            <TextBlock Style="{StaticResource HomeCaption}" Text="{DynamicResource HomeInstruction}"
                       TextAlignment="Center" Margin="12,10,12,0"/>
        </StackPanel>

        <!-- What is on screen now. Rows keep their place; only their buttons change. -->
        <StackPanel Grid.Row="3" Margin="0,22,0,0">
            <TextBlock Text="{DynamicResource HomeDevicesTitle}" Style="{StaticResource HomeSectionTitle}"/>
            <ItemsControl x:Name="DeviceRows" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="12" Background="{DynamicResource ControlFillBrush}"
                                Padding="12,8,6,8" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="20" VerticalAlignment="Center"
                                               Margin="0,0,12,0" Foreground="{DynamicResource TextBrush}"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Name}"/>
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource HomeCaption}"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="2" Content="{Binding PrimaryLabel}" Click="OnDevicePrimaryClick"
                                        Style="{StaticResource CompactButton}" Margin="8,0,0,0" VerticalAlignment="Center"
                                        IsEnabled="{Binding IsIdle}"/>
                                <Button Grid.Column="3" Click="OnDeviceStopClick" Style="{StaticResource HomeQuietButton}"
                                        Padding="8" Margin="2,0,0,0" VerticalAlignment="Center"
                                        Visibility="{Binding StopVisibility}" IsEnabled="{Binding IsIdle}"
                                        ToolTip="{DynamicResource HomeStopToolTip}"
                                        AutomationProperties.Name="{DynamicResource HomeStopToolTip}">
                                    <ui:SymbolIcon Style="{StaticResource ButtonSymbolIcon}" Symbol="Stop20" FontSize="16"/>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border x:Name="EmptyDevices" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource BorderSoftBrush}"
                    Padding="14,12">
                <TextBlock Style="{StaticResource HomeCaption}" Text="{DynamicResource HomeDevicesEmpty}" TextAlignment="Center"/>
            </Border>
            <TextBlock x:Name="FeedbackText" Style="{StaticResource HomeCaption}" Visibility="Collapsed"
                       Foreground="{DynamicResource WarningBrush}" Margin="4,8,4,0"
                       AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>

        <!-- The few things worth changing without opening everything. -->
        <StackPanel Grid.Row="4" Margin="0,22,0,0">
            <TextBlock Text="{DynamicResource HomeQualityTitle}" Style="{StaticResource HomeSectionTitle}"/>
            <Border CornerRadius="10" Background="{DynamicResource ControlFillBrush}" Padding="1">
                <UniformGrid Columns="3">
                    <RadioButton x:Name="QualityLight" GroupName="Quality" Style="{StaticResource HomeSegment}"
                                 Content="{DynamicResource HomeQualityLight}" Checked="OnQualityChecked"/>
                    <RadioButton x:Name="QualityStandard" GroupName="Quality" Style="{StaticResource HomeSegment}"
                                 Content="{DynamicResource HomeQualityStandard}" Checked="OnQualityChecked"/>
                    <RadioButton x:Name="QualityBest" GroupName="Quality" Style="{StaticResource HomeSegment}"
                                 Content="{DynamicResource HomeQualityBest}" Checked="OnQualityChecked"/>
                </UniformGrid>
            </Border>
            <TextBlock x:Name="QualityDetail" Style="{StaticResource HomeCaption}" Margin="4,6,4,0"/>

            <Grid Margin="4,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource HomeLaunchAtSignIn}" TextWrapping="Wrap" VerticalAlignment="Center"
                           Margin="0,0,12,0"/>
                <ToggleButton x:Name="LaunchAtSignInSwitch" Grid.Column="1" Style="{StaticResource HomeSwitch}"
                              Checked="OnLaunchAtSignInChanged" Unchecked="OnLaunchAtSignInChanged" VerticalAlignment="Center"
                              AutomationProperties.Name="{DynamicResource HomeLaunchAtSignIn}"/>
            </Grid>

            <Border Height="1" Background="{DynamicResource BorderSoftBrush}" Margin="0,18,0,8"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource HomeQuietButton}" Click="OnAllFeaturesClick"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        AutomationProperties.Name="{DynamicResource HomeAllFeatures}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource HomeAllFeatures}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{DynamicResource HomeAllFeaturesDetail}" Style="{StaticResource HomeCaption}"
                                       FontWeight="Normal" Margin="0,1,0,0"/>
                        </StackPanel>
                        <ui:SymbolIcon Grid.Column="1" Style="{StaticResource ButtonSymbolIcon}" Symbol="ChevronRight16" FontSize="14"
                                       Margin="10,0,4,0" VerticalAlignment="Center"/>
                    </Grid>
                </Button>
                <Button Grid.Column="1" Style="{StaticResource HomeQuietButton}" Click="OnExitClick"
                        Content="{DynamicResource HomeQuit}" VerticalAlignment="Center"/>
            </Grid>
        </StackPanel>
    </Grid>
    </Border>
</chrome:RoundedWindow>
